flowchart TB
    subgraph Clients["Client Layer (Kotlin/Swift)"]
        VM[PostMetadataCollectionViewModel]
        OC[ObservableMetadataCollection]
    end

    subgraph Collection["Collection Layer"]
        PMCEC[PostMetadataCollectionWithEditContext]
        MCC[["MetadataCollectionCore<br/>(joins metadata + state)"]]
        PMCEC -.->|composes| MCC
    end

    subgraph Service["Service Layer"]
        PS[PostService]
        MS[MetadataService]
        ESS[EntityStateStore]
    end

    subgraph Repository["Repository Layer (SQL)"]
        LMR[ListMetadataRepository]
    end

    subgraph DB["Database Tables"]
        LM[(ListMetadata)]
        LMS[(ListMetadataState)]
        LMI[(ListMetadataItems)]
    end

    %% Client to Collection
    VM -->|"refresh(), loadNextPage(), listInfo()"| OC
    OC -->|delegates| PMCEC

    %% Core reads via trait abstractions
    MCC -.->|ListMetadataReader| MS
    MCC -.->|EntityStateReader| ESS

    %% PostMetadataCollection owns sync logic
    PMCEC -->|"sync_list()"| PS
    PMCEC -->|"read_posts_by_ids_from_db()"| PS

    %% PostService to MetadataService
    PS -->|"refresh(key, per_page, fetcher)"| MS
    PS -->|"load_more(key, fetcher)"| MS
    PS -->|"fetch_posts_metadata()"| API[WordPress API]

    %% MetadataService to Repository
    MS -->|"get_or_create_and_increment_version()"| LMR
    MS -->|"update_state_by_list_metadata_id()"| LMR
    MS -->|"get_header()"| LMR
    MS -->|"set_items_by_list_metadata_id()"| LMR
    MS -->|"append_items_by_list_metadata_id()"| LMR
    MS -->|"update_header_by_list_metadata_id()"| LMR

    %% Repository to DB
    LMR -->|read/write| LM
    LMR -->|read/write| LMS
    LMR -->|read/write| LMI

    %% DB notifications back to clients
    LM -.->|UpdateHook| OC
    LMS -.->|UpdateHook| OC
    LMI -.->|UpdateHook| OC
